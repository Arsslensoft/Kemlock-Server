{
  "realm": "kemlock",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "groups": [
    { "name": "eng", "path": "/eng" },
    { "name": "ops", "path": "/ops" }
  ],
  "users": [
    {
      "username": "ada",
      "email": "ada@example.org",
      "firstName": "Ada",
      "lastName": "Lovelace",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "ada-password-1", "temporary": false }
      ],
      "groups": ["/eng"]
    },
    {
      "username": "mallory",
      "email": "mallory@example.org",
      "firstName": "Mallory",
      "lastName": "Unverified",
      "enabled": true,
      "emailVerified": false,
      "credentials": [
        { "type": "password", "value": "mallory-password-1", "temporary": false }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "kemlock",
      "name": "Kemlock Server",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "kemlock-gate-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://kemlock.test/kem/v1/auth/sso/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "backchannel.logout.url": "https://kemlock.test/kem/v1/auth/sso/backchannel-logout"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "claim.name": "groups",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}
