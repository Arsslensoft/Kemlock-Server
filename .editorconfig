# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# rustfmt's defaults (there is no rustfmt.toml): four spaces, 100 columns
[*.rs]
indent_size = 4
max_line_length = 100

# TOML and Dockerfiles are indented by what they hold (arrays, continued RUN lines)
[*.toml]
indent_size = 4

[Dockerfile*]
indent_size = 4

# Markdown keeps trailing double spaces (a line break) and its own wrapping
[*.md]
trim_trailing_whitespace = false

# Fixtures and vectors other apps wrote are compared byte for byte: leave them as they are
[test-vectors/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[**/fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
