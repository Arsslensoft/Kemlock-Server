{
  "name": "kemlock-web",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "The Kemlock Server web vault and admin console",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/precompress.ts && tsx scripts/check-budget.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:sso": "playwright test -c playwright.sso.config.ts",
    "gen:api": "npm --prefix tools/gen-api ci --no-audit --no-fund && tsx tools/gen-api/gen-api.ts && tsc -p tsconfig.wire.json",
    "budget": "tsx scripts/check-budget.ts",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@hookform/resolvers": "7.0.8",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "jsqr": "1.4.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-intl": "12.2.0",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "intl-messageformat": "12.2.0",
    "jsdom": "31.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
