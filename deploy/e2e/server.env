# What the server needs to use the Keycloak of deploy/e2e/compose.yml as its OpenID Connect
# provider (crates/kemlock-server/src/sso.rs). Load it into the shell that starts the server or
# runs `npx playwright test -c playwright.sso.config.ts`, which starts one itself:
#
#   set -a; . deploy/e2e/server.env; set +a
#
# DOMAIN is not here: the Playwright config sets it to the address of the server it starts
# (http://localhost:18081). A server you start yourself needs DOMAIN set to the address you give
# BASE_URL, and that address's port must be one of the realm's redirect URIs.
SSO_ENABLED=true
SSO_AUTHORITY=http://localhost:8180/realms/kemlock
SSO_CLIENT_ID=kemlock
SSO_CLIENT_SECRET=kemlock-e2e-secret
SSO_SCOPES=openid email profile
KEMLOCK_SSO_NAME=Keycloak
# The journeys sign in over SSO many times a minute from one address; each sign-in is three
# limited requests (start, callback, finish), so the default of 10 a minute is too few here.
KEMLOCK_RATE_SIGN_IN_PER_MINUTE=600
